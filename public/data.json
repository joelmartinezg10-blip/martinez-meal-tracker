  "recipes": [
    {
      "id": "chicken-fajitas",
      "name": "Chicken fajitas",
      "time": "35 min",
      "serves": "4 + kids plate",
      "kidNote": "kids: buttered pasta + fruit",
      "tags": ["weeknight", "skillet"],
      "ingredients": [
        "1.5 lb chicken thighs, sliced",
        "3 bell peppers, sliced",
        "1 yellow onion, sliced",
        "2 tbsp olive oil",
        "1 tsp chili powder, 1 tsp cumin, 1 tsp paprika, salt",
        "Juice of 2 limes",
        "Flour tortillas, salsa, sour cream, cilantro"
      ],
      "steps": [
        "Toss chicken with oil, spices, salt, and half the lime.",
        "Sear chicken in a hot skillet until browned and cooked through. Set aside.",
        "Cook peppers and onion in the same pan until charred-tender.",
        "Return chicken, splash remaining lime, and pile into warm tortillas.",
        "Kids plate: pasta with butter, fruit on the side. Skip the peppers if they push back."
      ]
    },
    {
      "id": "homemade-pizza",
      "name": "Homemade pizza",
      "time": "30 min",
      "serves": "4",
      "kidNote": "kids: plain cheese + fruit",
      "tags": ["friday", "family"],
      "ingredients": [
        "2 balls pizza dough",
        "1 cup pizza sauce",
        "12 oz mozzarella, shredded",
        "Toppings: pepperoni or leftover chicken, peppers, red onion",
        "Olive oil, salt"
      ],
      "steps": [
        "Heat oven to 475°F with a sheet pan inside.",
        "Stretch dough, oil the hot pan, and lay dough on it.",
        "Sauce, cheese, toppings. Keep one pizza cheese-only for the kids.",
        "Bake 12–15 minutes until the edges blister.",
        "Fruit bowl on the table so kids can graze while it cools."
      ]
    },
    {
      "id": "carne-asada-bowls",
      "name": "Carne asada bowls",
      "time": "40 min",
      "serves": "4",
      "kidNote": "kids: nuggets + fruit",
      "tags": ["weekend", "grill"],
      "ingredients": [
        "2 lb flank or skirt steak",
        "Juice of 3 limes, 3 garlic cloves, 1 tsp cumin, salt, pepper",
        "2 cups cooked rice",
        "1 can black beans, warmed",
        "Romaine, tomato, avocado, cilantro, salsa"
      ],
      "steps": [
        "Marinate steak 20+ minutes in lime, garlic, cumin, salt, and a little oil.",
        "Grill or broil on high, 3–5 minutes per side. Rest 5 minutes, slice thin.",
        "Build bowls: rice, beans, steak, salsa, avocado, cilantro.",
        "Kids plate: nuggets in the oven while the steak rests, fruit on the side."
      ]
    },
    {
      "id": "roast-chicken",
      "name": "Roast chicken + potatoes",
      "time": "1 hr 15 min",
      "serves": "4 + leftovers",
      "kidNote": "kids: pasta + fruit",
      "tags": ["sunday", "roast"],
      "ingredients": [
        "1 whole chicken",
        "2 lb russet potatoes, chunked",
        "Olive oil, salt, pepper, paprika, garlic",
        "1 lemon, halved",
        "Green onions to finish"
      ],
      "steps": [
        "Heat oven to 425°F. Pat chicken dry. Season all over. Stuff with lemon.",
        "Toss potatoes with oil and salt on the same sheet around the chicken.",
        "Roast 60–70 minutes until juices run clear (165°F in the thigh).",
        "Rest 10 minutes. Eat early so you can make the 4pm game.",
        "Kids plate: pasta with butter and parmesan, fruit cup. Save extra chicken for quesadillas."
      ]
    },
    {
      "id": "baked-ziti",
      "name": "Baked ziti",
      "time": "45 min",
      "serves": "6",
      "kidNote": "kids eat this — pasta night",
      "tags": ["pasta", "bake"],
      "ingredients": [
        "1 lb ziti or penne",
        "1 jar marinara plus a splash of water",
        "15 oz ricotta",
        "2 cups mozzarella, 1/2 cup parmesan",
        "1 egg, salt, pepper, garlic",
        "French bread + butter for garlic bread"
      ],
      "steps": [
        "Boil pasta 2 minutes under. Drain.",
        "Stir ricotta with egg, garlic, salt, half the parmesan.",
        "Fold pasta with marinara and ricotta. Layer in a baking dish with mozzarella.",
        "Bake 20–25 minutes at 375°F until bubbly. Broil 1 minute if you want browned spots.",
        "Garlic bread in the oven for the last 8 minutes. Kids usually eat this as-is."
      ]
    },
    {
      "id": "chicken-quesadillas",
      "name": "Chicken quesadillas",
      "time": "25 min",
      "serves": "4",
      "kidNote": "kids: cheese quesadilla + fruit",
      "tags": ["weeknight", "leftovers"],
      "ingredients": [
        "3 cups shredded leftover roast chicken (or rotisserie)",
        "8 flour tortillas",
        "2 cups shredded Mexican blend",
        "Salsa, sour cream, lime",
        "Optional: leftover peppers"
      ],
      "steps": [
        "Warm chicken with a pinch of taco seasoning and a splash of salsa.",
        "Cheese + chicken in tortillas. Press in a dry skillet until both sides are golden.",
        "Make at least two cheese-only quesadillas for the kids.",
        "Cut into triangles. Fruit and a little sour cream on the side."
      ]
    },
    {
      "id": "turkey-taco-skillet",
      "name": "Turkey taco skillet",
      "time": "30 min",
      "serves": "4",
      "kidNote": "kids: nuggets + apple slices",
      "tags": ["weeknight", "one-pan"],
      "ingredients": [
        "1.5 lb ground turkey",
        "1 onion, diced",
        "1 bell pepper, diced",
        "1 tbsp taco seasoning",
        "1 can black beans, drained",
        "1 cup salsa",
        "Tortilla chips, cheese, cilantro, lime"
      ],
      "steps": [
        "Brown turkey with onion and pepper. Drain if needed.",
        "Stir in seasoning, beans, and salsa. Simmer 8 minutes.",
        "Top with cheese to melt. Scoop over chips or rice.",
        "Kids plate: nuggets + apple slices. Offer a tiny scoop of turkey if they’re curious."
      ]
    },
    {
      "id": "teriyaki-chicken",
      "name": "Teriyaki chicken + rice",
      "time": "35 min",
      "serves": "4",
      "kidNote": "kids: pasta + fruit",
      "tags": ["weeknight", "rice"],
      "ingredients": [
        "1.5 lb chicken thighs",
        "1/3 cup soy sauce, 2 tbsp honey, 1 tbsp minced garlic, splash of water",
        "2 cups jasmine rice, cooked",
        "Broccoli florets",
        "Green onions, sesame seeds if you have them"
      ],
      "steps": [
        "Start the rice. Steam or microwave broccoli.",
        "Sear chicken thighs until browned and cooked through. Slice.",
        "Pour soy, honey, garlic, and a splash of water into the pan. Bubble until glossy. Toss chicken.",
        "Serve over rice with broccoli and green onions.",
        "Kids plate: pasta + fruit. A little teriyaki chicken on the side if they want it."
      ]
    },
    {
      "id": "smash-burgers",
      "name": "Smash burgers",
      "time": "25 min",
      "serves": "4",
      "kidNote": "kids: nuggets + fruit",
      "tags": ["friday", "skillet"],
      "ingredients": [
        "1.5 lb ground beef, loosely packed into 8 balls",
        "Burger buns",
        "Cheddar slices",
        "Pickles, ketchup, onion",
        "Salt, pepper, butter for the buns"
      ],
      "steps": [
        "Heat a cast-iron or griddle until very hot. Toast buns in butter.",
        "Smash each beef ball hard on the skillet. Salt and pepper. Flip after a deep crust forms.",
        "Cheese on the second side for 30 seconds. Stack two patties if you want doubles.",
        "Pickles and ketchup. Keep toppings on the side for picky eaters.",
        "Kids plate: nuggets + fruit. Offer a plain slider if they ask."
      ]
    },
    {
      "id": "pancake-night",
      "name": "Pancake night",
      "time": "30 min",
      "serves": "4",
      "kidNote": "kids: pancakes + berries",
      "tags": ["weekend", "breakfast-for-dinner"],
      "ingredients": [
        "Pancake mix + eggs + milk per box",
        "Butter and maple syrup",
        "Berries (fresh or frozen, warmed)",
        "Bacon",
        "Scrambled eggs if you want extra protein"
      ],
      "steps": [
        "Oven-bake bacon at 400°F on a sheet pan, 15–18 minutes.",
        "Mix pancakes. Cook on a buttered griddle until bubbles set.",
        "Warm berries with a spoon of maple for a quick sauce.",
        "Kids eat pancakes and berries. Adults add bacon and eggs.",
        "Leftover pancakes freeze — weekday breakfast win."
      ]
